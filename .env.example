# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored. Never commit real keys.

# Supabase / Database Connection
# Use the connection pooler URI (Project Settings > Database > Connection string).
# db.<ref>.supabase.co:5432 is IPv6-only and fails on most IPv4 networks.
SUPABASE_DB=postgresql://postgres.your-project-ref:your-db-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://your-project-ref.supabase.co
# Server-only. Used to upload case documents to private storage.
SUPABASE_SECRET_KEY=your_supabase_secret_key
SUPABASE_DOCUMENTS_BUCKET=case-documents

# Auth (Better Auth, email + password)
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your_random_32_byte_secret
# Public URL of the site: http://localhost:3000 locally, your Vercel URL in production
BETTER_AUTH_URL=http://localhost:3000
